# ==============================================================================
# B2B SaaS Traffic Fine Monitoring - Environment Configuration Template
# DO NOT COMMIT THE ACTUAL `.env` FILE CONTAINING SENSITIVE VALUES TO GIT.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
APP_NAME="Traffic Fines B2B Monitor SaaS"
APP_VERSION="1.0.0"
DEBUG=False
PORT=8000
HOST=0.0.0.0

# Cybersecurity & Authentication
# Generate a cryptographically secure 256-bit key (e.g. `openssl rand -hex 32`)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-secret
API_KEY_HEADER_NAME=X-API-Key
# Default master API key for administrative operations in development
ADMIN_API_KEY=dev-admin-secure-api-key-replace-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (Comma-separated URLs; DO NOT use '*' in production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting & Protection (requests per minute per client)
RATE_LIMIT_PER_MINUTE=60

# Database Configuration (Multi-tenant schema)
DATABASE_URL=postgresql+asyncpg://app_user:strong_password@localhost:5432/fines_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Fine Provider & Scraping / API Connectors
SCRAPER_REQUEST_TIMEOUT_SECONDS=15
SCRAPER_MAX_RETRIES=3
SCRAPER_USER_AGENT="FleetMonitorBot/1.0 (+https://finesmonitor.example.com/bot)"

# Security Headers Configuration
ENABLE_HSTS=True
CONTENT_SECURITY_POLICY="default-src 'self'; frame-ancestors 'none';"
